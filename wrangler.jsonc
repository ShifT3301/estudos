{
  "name": "estudos-app",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Banco D1 (SQLite do Cloudflare). Sem "database_id", o `wrangler deploy` cria o banco sozinho.
  "d1_databases": [{ "binding": "DB" }]
}
